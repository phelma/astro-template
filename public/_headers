# Cloudflare static-asset response headers (Workers static assets & Pages).
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
#
# Syntax: a URL pattern line, then indented "Name: value" lines.
# A request matching several rules gets ALL their headers; the same header
# set by two matching rules is joined with ", " (so don't set Cache-Control
# on /* and again on /_astro/*). "! Name" removes a header from broader rules.
# Not applied to responses generated by Worker code (SSR / run_worker_first).

/*
  # HTTPS only for 2 years, including subdomains. Before adding "; preload"
  # (hstspreload.org) make sure EVERY subdomain serves HTTPS: preload list
  # removal takes months.
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  # Don't let browsers MIME-sniff responses into another type.
  X-Content-Type-Options: nosniff
  # Clickjacking: never render this site in a frame (legacy header)...
  X-Frame-Options: DENY
  # ...and the modern equivalent. The main CSP is a <meta> tag generated by
  # Astro (security.csp in astro.config.ts), where frame-ancestors is ignored.
  # Browsers enforce every CSP independently (a request must pass all), so
  # this header must ONLY hold directives that don't restrict what the meta
  # CSP allows: frame-ancestors (and optionally report-to/report-uri).
  Content-Security-Policy: frame-ancestors 'none'
  # Send origin only on cross-origin requests, nothing on HTTPS -> HTTP.
  Referrer-Policy: strict-origin-when-cross-origin
  # Disable powerful features this site doesn't use (for us and any iframes).
  # Enable one by listing origins, e.g. fullscreen=(self). browsing-topics=()
  # opts out of Chrome's Topics ad-interest API.
  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  # Isolate the browsing context from cross-origin popups/openers.
  Cross-Origin-Opener-Policy: same-origin

# Caching. HTML and other un-hashed files (icons, robots.txt, ...) keep
# Cloudflare's default "Cache-Control: public, max-age=0, must-revalidate"
# plus an ETag: always revalidated, so deploys show up immediately.

# Astro's build output (JS, CSS, optimised images and Fonts API files under
# /_astro/fonts/) has content hashes in its filenames: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the platform hostnames (not your custom domain) out of search results.
# Uncomment and set your project / worker / account names:
# https://:project.pages.dev/*
#   X-Robots-Tag: noindex
# https://:version.:project.pages.dev/*
#   X-Robots-Tag: noindex
# https://my-worker.my-account.workers.dev/*
#   X-Robots-Tag: noindex
