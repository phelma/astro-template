# Copy to `.env` for local builds and set the same variables in your host's
# build settings (e.g. Cloudflare > Settings > Variables and secrets).
# Declared and validated in astro.config.ts (`env.schema`). All optional.

# Google Maps Embed API key for the map block (src/components/blocks/map).
# Free with no usage limit. Public: it is written into the page, so in Google
# Cloud restrict it to the "Maps Embed API" and to HTTP referrers on your
# domain(s). Unset: maps fall back to Google's keyless embed URL (unofficial).
# https://developers.google.com/maps/documentation/embed/get-api-key
PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Optional Maps Static API key: a real map image behind the click-to-load
# facade instead of the drawn placeholder. Billed per image view, and the
# image is fetched from Google before the visitor clicks (their IP address
# reaches Google), so leave it empty unless you need it. Restrict it to the
# "Maps Static API" and your domain(s).
PUBLIC_GOOGLE_MAPS_STATIC_KEY=
