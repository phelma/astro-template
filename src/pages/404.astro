---
import HeroActions from "@/components/blocks/hero/HeroActions.astro"
import HeroContent from "@/components/blocks/hero/HeroContent.astro"
import HeroEyebrow from "@/components/blocks/hero/HeroEyebrow.astro"
import HeroLede from "@/components/blocks/hero/HeroLede.astro"
import HeroRoot from "@/components/blocks/hero/HeroRoot.astro"
import HeroTitle from "@/components/blocks/hero/HeroTitle.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { siteConfig } from "@/site.config"

const links = siteConfig.nav.filter((link) => link.href !== "/")
---

<BaseLayout
  title="Page not found"
  description="The page you are looking for could not be found."
  noindex
>
  <HeroRoot layout="minimal" size="lg" aria-labelledby="not-found-title">
    <HeroContent>
      <HeroEyebrow class="font-mono tracking-normal text-muted-foreground normal-case">
        Error 404
      </HeroEyebrow>
      <HeroTitle id="not-found-title">Page not found</HeroTitle>
      <HeroLede>
        The page may have moved or no longer exists. Check the address, or use
        one of the links below.
      </HeroLede>
      <HeroActions
        actions={[
          {
            label: "Go to the home page",
            href: "/",
            icon: "lucide:house",
            iconPosition: "start",
          },
        ]}
      />
      {links.length > 0 && (
        <nav aria-label="Helpful links">
          <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-6 items-center underline underline-offset-4 hover:text-muted-foreground"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </HeroContent>
  </HeroRoot>
</BaseLayout>
