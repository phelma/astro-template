---
import { Icon } from "astro-icon/components"
import type { ContactPage, WithContext } from "schema-dts"

import CheckboxField from "@/components/blocks/form/CheckboxField.astro"
import Form from "@/components/blocks/form/Form.astro"
import FormField from "@/components/blocks/form/FormField.astro"
import FormSubmit from "@/components/blocks/form/FormSubmit.astro"
import { formSurfaceVariants } from "@/components/blocks/form/variants"
import MapSection from "@/components/blocks/map/MapSection.astro"
import OpeningHours from "@/components/blocks/opening-hours/OpeningHours.astro"
import Section from "@/components/blocks/section/Section.astro"
import PageHeader from "@/components/sections/PageHeader.astro"
import JsonLd from "@/components/seo/JsonLd.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { telHref } from "@/lib/nav"
import { absoluteUrl, organizationId, pagePath, websiteId } from "@/lib/seo"
import { cn } from "@/lib/utils"
import { siteConfig } from "@/site.config"

const { email, phone, socials } = siteConfig.contact
const title = "Contact"
const description = `How to contact ${siteConfig.name}: email, phone, address and social profiles.`

const contactPageSchema: WithContext<ContactPage> = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  url: absoluteUrl(pagePath(Astro.url.pathname), Astro.site),
  name: `${title} | ${siteConfig.name}`,
  description,
  isPartOf: { "@id": websiteId(Astro.site) },
  about: { "@id": organizationId(Astro.site) },
}
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[{ name: "Home", href: "/" }, { name: title }]}
>
  <JsonLd slot="head" data={contactPageSchema} />

  <PageHeader
    title={`Contact ${siteConfig.name}`}
    lede="We usually reply within two working days."
  />

  <Section spacing="none" containerClass="pb-16" as="div">
    <div class="grid gap-12 lg:grid-cols-5">
      <div class={cn(formSurfaceVariants(), "lg:col-span-3")}>
        <h2 id="message-title" class="text-2xl">
          Send us a message
        </h2>
        {/* Posts to this page until a form provider is set: pass its endpoint
            as `action`. */}
        <Form
          id="message"
          aria-labelledby="message-title"
          success={{
            title: "Thanks, your message has been sent",
            message: "We'll get back to you as soon as we can.",
          }}
        >
          <FormField
            id="message-name"
            name="name"
            label="Name"
            autocomplete="name"
            required
            size="lg"
            messages={{ valueMissing: "Enter your name" }}
          />
          <FormField
            id="message-email"
            name="email"
            type="email"
            label="Email"
            autocomplete="email"
            required
            size="lg"
            messages={{ valueMissing: "Enter your email address" }}
          />
          <FormField
            id="message-body"
            name="message"
            control="textarea"
            label="Message"
            required
            rows={5}
            size="lg"
            messages={{ valueMissing: "Enter your message" }}
          />
          <CheckboxField
            id="message-consent"
            name="consent"
            required
            messages={{ valueMissing: "Tick the box so we can reply to you" }}
          >
            I agree to {siteConfig.name} using my details to reply to this
            enquiry. Read our <a href="/privacy">privacy policy</a>.
          </CheckboxField>
          <FormSubmit icon="lucide:send">Send message</FormSubmit>
        </Form>
      </div>
      <aside aria-labelledby="contact-details-title" class="lg:col-span-2">
        <h2 id="contact-details-title" class="mb-6 text-2xl">
          Other ways to reach us
        </h2>
        <dl class="flex flex-col gap-6">
          {email && (
            <div class="flex flex-col gap-1">
              <dt class="flex items-center gap-2 font-medium">
                <Icon name="lucide:mail" class="size-4" aria-hidden="true" />
                Email
              </dt>
              <dd>
                <a
                  href={`mailto:${email}`}
                  class="text-muted-foreground underline underline-offset-4 hover:text-foreground"
                >
                  {email}
                </a>
              </dd>
            </div>
          )}

          {phone && (
            <div class="flex flex-col gap-1">
              <dt class="flex items-center gap-2 font-medium">
                <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
                Phone
              </dt>
              <dd>
                <a
                  href={telHref(phone)}
                  class="text-muted-foreground underline underline-offset-4 hover:text-foreground"
                >
                  {phone}
                </a>
              </dd>
            </div>
          )}

          {socials.length > 0 && (
            <div class="flex flex-col gap-1">
              <dt class="flex items-center gap-2 font-medium">
                <Icon name="lucide:at-sign" class="size-4" aria-hidden="true" />
                Social
              </dt>
              <dd>
                <ul class="flex flex-col gap-1">
                  {socials.map((social) => (
                    <li>
                      <a
                        href={social.href}
                        target="_blank"
                        rel="noopener noreferrer me"
                        class="inline-flex min-h-6 items-center gap-2 text-muted-foreground underline underline-offset-4 hover:text-foreground"
                      >
                        <Icon
                          name={social.icon}
                          class="size-4"
                          aria-hidden="true"
                        />
                        {siteConfig.name} on {social.label}
                        <span class="sr-only">(opens in a new tab)</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      </aside>
    </div>
  </Section>

  <MapSection tone="muted" phone={false} email={false}>
    <OpeningHours slot="hours" variant="bare" headingLevel={3} />
  </MapSection>
</BaseLayout>
