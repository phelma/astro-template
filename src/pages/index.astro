---
import { Icon } from "astro-icon/components"

import CtaBand from "@/components/sections/CtaBand.astro"
import Features, { type Feature } from "@/components/sections/Features.astro"
import Hero from "@/components/sections/Hero.astro"
import { buttonVariants } from "@/components/ui/button"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { siteConfig } from "@/site.config"
import heroImage from "@/assets/hero-placeholder.jpg"

// Placeholder copy: replace with your own.
const features: Feature[] = [
  {
    icon: "lucide:zap",
    title: "Fast by default",
    description:
      "Static HTML, zero client JavaScript for components, optimised images and self-hosted fonts.",
  },
  {
    icon: "lucide:accessibility",
    title: "Accessible",
    description:
      "Semantic landmarks, a skip link, visible focus styles and AA contrast in every theme.",
  },
  {
    icon: "lucide:search",
    title: "Search ready",
    description:
      "Canonical URLs, Open Graph cards, JSON-LD, a sitemap and robots.txt generated from one config file.",
  },
]
---

<BaseLayout>
  <Hero
    title={`${siteConfig.name}: fast, accessible websites`}
    lede="A minimal starting point built with Astro, Tailwind CSS and shadcn/ui. Replace this copy, pick a theme and ship."
    image={heroImage}
    imageAlt="Wireframe of a web page layout with a headline, two buttons and content cards."
  >
    <a href="/contact" class={buttonVariants({ size: "lg" })}>
      Get in touch
      <Icon name="lucide:arrow-right" aria-hidden="true" />
    </a>
    <a href="/about" class={buttonVariants({ size: "lg", variant: "outline" })}>
      About {siteConfig.shortName}
    </a>
  </Hero>

  <Features
    title="What you get"
    intro="Sensible defaults so you can focus on content."
    features={features}
  />

  <CtaBand
    title="Ready to start a project?"
    text="Tell us what you are building and we will get back to you."
  >
    <a href="/contact" class={buttonVariants({ size: "lg" })}>
      Contact {siteConfig.shortName}
    </a>
  </CtaBand>
</BaseLayout>
