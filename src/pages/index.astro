---
import Cta from "@/components/blocks/cta/Cta.astro"
import Features from "@/components/blocks/features/Features.astro"
import type { FeatureItem } from "@/components/blocks/features/variants"
import Hero from "@/components/blocks/hero/Hero.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { siteConfig } from "@/site.config"
import heroImage from "@/assets/hero-placeholder.jpg"

// Placeholder copy: replace with your own.
const features: FeatureItem[] = [
  {
    icon: "lucide:zap",
    title: "Fast by default",
    description:
      "Static HTML, zero client JavaScript for components, optimised images and self-hosted fonts.",
  },
  {
    icon: "lucide:accessibility",
    title: "Accessible",
    description:
      "Semantic landmarks, a skip link, visible focus styles and AA contrast in every theme.",
  },
  {
    icon: "lucide:search",
    title: "Search ready",
    description:
      "Canonical URLs, Open Graph cards, JSON-LD, a sitemap and robots.txt generated from one config file.",
  },
]
---

<BaseLayout>
  <Hero
    title={`${siteConfig.name}: fast, accessible websites`}
    lede="A minimal starting point built with Astro, Tailwind CSS and shadcn/ui. Replace this copy, pick a theme and ship."
    image={heroImage}
    imageAlt="Wireframe of a web page layout with a headline, two buttons and content cards."
    actions={[
      { label: "Get in touch", href: "/contact", icon: "lucide:arrow-right" },
      {
        label: `About ${siteConfig.shortName}`,
        href: "/about",
        variant: "outline",
      },
    ]}
  />

  <Features
    variant="cards"
    title="What you get"
    lede="Sensible defaults so you can focus on content."
    items={features}
  />

  <Cta
    title="Ready to start a project?"
    text="Tell us what you are building and we will get back to you."
    actions={[{ label: `Contact ${siteConfig.shortName}`, href: "/contact" }]}
  />
</BaseLayout>
