---
import { Icon } from "astro-icon/components"

import { Button } from "@/components/ui/button"
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout>
  <section class="mx-auto flex max-w-6xl flex-col items-start gap-4 px-4 py-16 sm:px-6">
    <h1 class="text-4xl">Astro template</h1>
    <p class="text-muted-foreground">
      This button is a React component rendered at build time with zero client
      JavaScript.
    </p>
    <Button>
      <Icon name="lucide:sparkles" aria-hidden="true" />
      Button
    </Button>
  </section>
</BaseLayout>
