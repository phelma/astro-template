---
/**
 * Site footer: secondary links (siteConfig.footer), social profiles
 * (siteConfig.contact.socials, icons via astro-icon) and copyright.
 */
import { Icon } from "astro-icon/components"

import { isExternal } from "@/lib/nav"
import { siteConfig } from "@/site.config"

const year = new Date().getFullYear()
const owner = siteConfig.organisation.legalName ?? siteConfig.organisation.name
const { socials } = siteConfig.contact
---

<footer class="border-t">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-8 text-sm text-muted-foreground sm:px-6 md:flex-row md:items-center md:justify-between">
    <p>
      &copy; {year} {owner}
    </p>

    {siteConfig.footer.length > 0 && (
      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-4 gap-y-2">
          {siteConfig.footer.map((link) => {
            const external = isExternal(link)
            return (
              <li>
                <a
                  href={link.href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  class="inline-flex min-h-6 items-center underline-offset-4 hover:text-foreground hover:underline"
                >
                  {link.label}
                </a>
              </li>
            )
          })}
        </ul>
      </nav>
    )}

    {socials.length > 0 && (
      <ul class="flex items-center gap-1" aria-label="Social profiles">
        {socials.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer me"
              class="inline-flex size-9 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground"
            >
              <Icon name={social.icon} class="size-4" aria-hidden="true" />
              <span class="sr-only">{social.label}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</footer>
