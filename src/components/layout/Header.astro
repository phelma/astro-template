---
/**
 * Site header: brand, primary nav (from siteConfig.nav), theme controls and a
 * mobile menu built on the native Popover API (no JS, light-dismiss, Esc to
 * close, focus handled by the browser, aria-expanded exposed on the invoker).
 */
import { Icon } from "astro-icon/components"

import ThemeSwitcher from "@/components/theme/ThemeSwitcher.astro"
import ThemeToggle from "@/components/theme/ThemeToggle.astro"
import { ariaCurrent, isExternal } from "@/lib/nav"
import { siteConfig } from "@/site.config"

const { pathname } = Astro.url
const links = siteConfig.nav.map((link) => ({
  ...link,
  current: ariaCurrent(link.href, pathname),
  external: isExternal(link),
}))
---

<header class="sticky top-0 z-40 border-b bg-background/90 backdrop-blur supports-backdrop-filter:bg-background/75">
  <div class="mx-auto flex h-(--header-height) max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a
      href="/"
      class="mr-auto inline-flex min-h-6 items-center font-heading text-lg font-semibold tracking-tight"
    >
      <span class="sm:hidden">{siteConfig.shortName}</span>
      <span class="hidden sm:inline">{siteConfig.name}</span>
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.current}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="inline-flex h-9 items-center rounded-md px-3 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground aria-[current]:text-foreground"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <ThemeSwitcher class="hidden md:inline-flex" />
      <ThemeToggle class="hidden md:inline-flex" />
      <button
        type="button"
        popovertarget="mobile-nav"
        class="inline-flex size-10 items-center justify-center rounded-md border bg-background text-foreground hover:bg-accent hover:text-accent-foreground md:hidden"
      >
        <Icon name="lucide:menu" class="size-5" aria-hidden="true" />
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    popover
    class="inset-0 m-0 hidden h-dvh max-h-none w-full max-w-none flex-col gap-6 overflow-y-auto bg-background p-4 text-foreground open:flex md:open:hidden"
  >
    <div class="flex h-(--header-height) shrink-0 items-center justify-between">
      <span class="font-heading text-lg font-semibold tracking-tight">
        {siteConfig.name}
      </span>
      <button
        type="button"
        popovertarget="mobile-nav"
        popovertargetaction="hide"
        class="inline-flex size-10 items-center justify-center rounded-md border bg-background hover:bg-accent hover:text-accent-foreground"
      >
        <Icon name="lucide:x" class="size-5" aria-hidden="true" />
        <span class="sr-only">Close menu</span>
      </button>
    </div>
    <nav aria-label="Main">
      <ul class="flex flex-col gap-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.current}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="flex min-h-11 items-center rounded-md px-3 text-base font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground aria-[current]:bg-accent aria-[current]:text-accent-foreground"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex flex-wrap items-center gap-3 border-t pt-6">
      <ThemeToggle name="color-mode-mobile" />
      <ThemeSwitcher id="theme-switcher-mobile" />
    </div>
  </div>
</header>

<style>
  /* Lock page scroll while the full-screen mobile menu is open. */
  :global(html:has(#mobile-nav:popover-open)) {
    overflow: hidden;
  }
</style>
