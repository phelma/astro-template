---
/**
 * Site header: the default composition of the navbar block, driven by
 * siteConfig.header (layout, sticky, phone, CTA, top bar), siteConfig.nav
 * (items with `children` become dropdowns) and siteConfig.announcement.
 *
 * Renders, in order: the announcement banner, the optional top bar, then the
 * navbar (<header> landmark: brand, desktop nav, phone, theme controls, CTA
 * and the popover mobile menu). They are siblings rather than nested so a
 * sticky navbar stays stuck for the whole page while the banner and top bar
 * scroll away. To restyle, change siteConfig.header or edit the parts in
 * src/components/blocks/navbar/.
 */
import Announcement from "@/components/blocks/announcement/Announcement.astro"
import Navbar from "@/components/blocks/navbar/Navbar.astro"
import NavbarBrand from "@/components/blocks/navbar/NavbarBrand.astro"
import NavbarCta from "@/components/blocks/navbar/NavbarCta.astro"
import NavbarLinks from "@/components/blocks/navbar/NavbarLinks.astro"
import NavbarMobileMenu from "@/components/blocks/navbar/NavbarMobileMenu.astro"
import NavbarPhone from "@/components/blocks/navbar/NavbarPhone.astro"
import NavbarTopBar from "@/components/blocks/navbar/NavbarTopBar.astro"
import type {
  NavbarMobileMenuVariants,
  NavbarVariants,
} from "@/components/blocks/navbar/variants"
import ThemeSwitcher from "@/components/theme/ThemeSwitcher.astro"
import ThemeToggle from "@/components/theme/ThemeToggle.astro"
import { siteConfig } from "@/site.config"

// Options not (yet) in the siteConfig.header schema fall back to today's look.
const header = siteConfig.header as typeof siteConfig.header & {
  variant?: NavbarVariants["variant"]
  bordered?: boolean
  mobileMenu?: NavbarMobileMenuVariants["menu"]
}
const { nav, name, contact } = siteConfig
const showPhone = header.showPhone && Boolean(contact.phone)
---

<Announcement />

{header.topBar && <NavbarTopBar />}

<Navbar
  layout={header.layout}
  sticky={header.sticky}
  variant={header.variant ?? "blurred"}
  bordered={header.bordered ?? true}
>
  <NavbarBrand slot="start" />

  <NavbarLinks items={nav} />

  <Fragment slot="end">
    {showPhone && <NavbarPhone />}
    <ThemeSwitcher class="hidden md:inline-flex" />
    <ThemeToggle class="hidden md:inline-flex" />
    {header.cta && (
      <NavbarCta
        href={header.cta.href}
        label={header.cta.label}
        external={header.cta.external}
        class="hidden sm:inline-flex"
      />
    )}
    <NavbarMobileMenu
      id="mobile-nav"
      items={nav}
      title={name}
      menu={header.mobileMenu ?? "fullscreen"}
    >
      {header.cta && (
        <NavbarCta
          href={header.cta.href}
          label={header.cta.label}
          external={header.cta.external}
          class="w-full"
        />
      )}
      {showPhone && <NavbarPhone display="full" class="min-h-11" />}
      <ThemeToggle name="color-mode-mobile" />
      <ThemeSwitcher id="theme-switcher-mobile" />
    </NavbarMobileMenu>
  </Fragment>
</Navbar>
