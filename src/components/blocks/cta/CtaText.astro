---
/**
 * Supporting text under the call-to-action title. Muted; on the primary tone
 * `--muted-foreground` is re-pointed at the band's text colour by the tone.
 */
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"p">

const { class: className, ...rest } = Astro.props
---

<p
  data-slot="cta-text"
  class={cn("max-w-prose text-lg text-muted-foreground", className)}
  {...rest}
>
  <slot />
</p>
