---
/**
 * Image beside a split call to action (or custom media via the default
 * slot). Cropped to 4:3 and lazy-loaded: CTAs sit below the fold.
 */
import type { ImageMetadata } from "astro"
import type { HTMLAttributes } from "astro/types"
import { Picture } from "astro:assets"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  image?: ImageMetadata
  /** Describe the image; "" only if purely decorative. Required with `image`. */
  alt?: string
  /** Classes for the <img>. */
  imageClass?: string
}

const { image, alt = "", imageClass, class: className, ...rest } = Astro.props

const width = image ? Math.min(image.width, 640) : 0
---

<div data-slot="cta-media" class={cn("w-full", className)} {...rest}>
  {Astro.slots.has("default") ? (
    <slot />
  ) : (
    image && (
      <Picture
        src={image}
        alt={alt}
        formats={["avif", "webp"]}
        width={width}
        height={Math.round((width * 3) / 4)}
        sizes="(min-width: 1024px) 560px, 100vw"
        class={cn(
          "aspect-4/3 h-auto w-full rounded-xl border object-cover shadow-md",
          imageClass
        )}
      />
    )
  )}
</div>
