---
/**
 * Online booking widget (Calendly or any provider that offers an iframe),
 * lazy-loaded, with an "Open the booking page" link below it for visitors
 * who prefer the provider's own page.
 *
 *   <BookingEmbed provider="calendly" src="https://calendly.com/acme/visit" />
 *   <BookingEmbed src="https://widget.example-provider.com/acme" />
 *
 * Props: `src` defaults to `business.bookingUrl` (siteConfig).
 * `provider="calendly"` adds `embed_type=Inline&embed_domain=<site host>`,
 * as Calendly's own inline widget sends. `fallbackHref` (default: `src`) is
 * the link target, `fallbackLabel` its text (`false` hides it). `title`
 * names the iframe.
 *
 * Providers that forbid framing (many only offer a link or a script widget)
 * need BookingCta.
 *
 * Customise: `variant`, `aspect` (default "tall"; set the height with
 * `class="[--embed-height:50rem]"`), `frameClass`. Parts:
 * `data-slot="booking-embed"`, `booking-embed-link` and the `embed-*` slots.
 */
import type { HTMLAttributes } from "astro/types"
import { Icon } from "astro-icon/components"

import Embed from "@/components/blocks/embed/Embed.astro"
import type { EmbedVariants } from "@/components/blocks/embed/variants"
import { cn } from "@/lib/utils"
import { siteConfig } from "@/site.config"

type Props = Omit<HTMLAttributes<"div">, "title"> &
  EmbedVariants & {
    src?: string
    provider?: "calendly"
    title?: string
    fallbackHref?: string
    fallbackLabel?: string | false
    frameClass?: string
  }

const {
  src: srcProp = siteConfig.business.bookingUrl,
  provider,
  title = `Online booking for ${siteConfig.name}`,
  fallbackHref,
  fallbackLabel = "Open the booking page",
  variant,
  aspect = "tall",
  class: className,
  frameClass,
  ...rest
} = Astro.props

if (!srcProp) {
  throw new Error(
    "BookingEmbed: pass src or set business.bookingUrl in site.config.ts"
  )
}

let src = srcProp
if (provider === "calendly") {
  const url = new URL(srcProp)
  url.searchParams.set("embed_type", "Inline")
  if (Astro.site) url.searchParams.set("embed_domain", Astro.site.hostname)
  src = url.toString()
}
---

<div
  data-slot="booking-embed"
  class={cn("flex flex-col gap-3", className)}
  {...rest}
>
  <Embed
    src={src}
    title={title}
    allow="payment"
    variant={variant}
    aspect={aspect}
    class={frameClass}
  />
  {fallbackLabel && (
    <a
      href={fallbackHref ?? srcProp}
      target="_blank"
      rel="noopener noreferrer"
      data-slot="booking-embed-link"
      class="inline-flex min-h-6 items-center gap-1.5 self-start text-sm text-muted-foreground underline underline-offset-2 hover:text-foreground"
    >
      <Icon name="lucide:external-link" aria-hidden="true" />
      {fallbackLabel}
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  )}
</div>
