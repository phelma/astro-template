---
/**
 * Feature description: one or two sentences, muted.
 */
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"p">

const { class: className, ...rest } = Astro.props
---

<p
  data-slot="features-description"
  class={cn(
    "text-muted-foreground group-data-[variant=cards]/features:text-sm group-data-[variant=checklist]/features:text-sm",
    className
  )}
  {...rest}
>
  <slot />
</p>
