---
/**
 * One customer testimonial: optional star rating, the quote and who said it
 * (name, job/place, optional avatar and review source). Renders a <figure>
 * with <blockquote> + <figcaption>. The default slot replaces the quote text
 * for rich content (several paragraphs, emphasis).
 *
 *   <TestimonialCard quote="..." name="Sarah P." context="Boiler service, York" rating={5} />
 *   <TestimonialCard {...item} variant="plain" size="lg" />
 */
import type { HTMLAttributes } from "astro/types"
import { Image } from "astro:assets"

import { cn } from "@/lib/utils"

import StarRating from "./StarRating.astro"
import type { Testimonial } from "./types"
import {
  testimonialCardVariants,
  testimonialQuoteVariants,
  type TestimonialCardVariants,
} from "./variants"

type Props = Omit<HTMLAttributes<"figure">, keyof Testimonial> &
  TestimonialCardVariants &
  Testimonial

const {
  quote,
  name,
  context,
  rating,
  source,
  sourceHref,
  avatar,
  avatarAlt,
  variant,
  size,
  class: className,
  ...rest
} = Astro.props

const initials = name
  .split(/\s+/)
  .map((part) => part[0])
  .join("")
  .slice(0, 2)
  .toUpperCase()
const avatarSize = size === "lg" ? 56 : 44
---

<figure
  data-slot="testimonial-card"
  class={cn(testimonialCardVariants({ variant, size }), className)}
  {...rest}
>
  {rating !== undefined && (
    <StarRating rating={rating} size={size === "lg" ? "lg" : "default"} />
  )}
  <blockquote
    data-slot="testimonial-quote"
    class={cn(
      testimonialQuoteVariants({ size }),
      "flex flex-col gap-3 [&>p:first-child]:before:content-[open-quote] [&>p:last-child]:after:content-[close-quote]"
    )}
  >
    <slot>
      <p>{quote}</p>
    </slot>
  </blockquote>
  <figcaption
    data-slot="testimonial-author"
    class={cn(
      "mt-auto flex items-center gap-3 pt-2",
      size === "lg" && "flex-col gap-2 sm:flex-row sm:gap-3"
    )}
  >
    {avatar ? (
      <Image
        data-slot="testimonial-avatar"
        src={avatar}
        alt={avatarAlt}
        width={avatarSize}
        height={avatarSize}
        layout="fixed"
        class="shrink-0 rounded-full object-cover"
      />
    ) : (
      <span
        data-slot="testimonial-avatar"
        class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-muted text-sm font-semibold text-muted-foreground"
        aria-hidden="true"
      >
        {initials}
      </span>
    )}
    <span class={cn("flex flex-col", size !== "lg" && "text-left")}>
      <span data-slot="testimonial-name" class="font-semibold">
        {name}
      </span>
      {(context || source) && (
        <span
          data-slot="testimonial-context"
          class="text-sm text-muted-foreground"
        >
          {context}
          {context && source && " · "}
          {source &&
            (sourceHref ? (
              <a
                data-slot="testimonial-source"
                href={sourceHref}
                class="underline underline-offset-4 hover:text-foreground"
              >
                Review on {source}
              </a>
            ) : (
              <span data-slot="testimonial-source">Review on {source}</span>
            ))}
        </span>
      )}
    </span>
  </figcaption>
</figure>
