---
/**
 * Lazy-loaded Google Map, with "Get directions" and "Open in Google Maps"
 * links below it.
 *
 *   <Map />                                    // siteConfig name + address
 *   <Map variant="bare" aspect="wide" />       // edge to edge
 *   <Map placeId="ChIJ..." zoom={16} />        // exact Google listing
 *   <Map lat={53.7997} lng={-1.5492} />        // coordinates only
 *
 * Data: defaults from siteConfig (`name`, `contact.address`, `business.geo`,
 * `business.googleMapsUrl`); every value can be passed as a prop. Location
 * precedence: `placeId`, then `query` (default "<name>, <address>"), then
 * `lat` / `lng`. Passing `lat` / `lng` without `query` maps the coordinates.
 *
 * Embed URL: with `PUBLIC_GOOGLE_MAPS_EMBED_KEY` set (astro.config.ts
 * `env.schema`, see .env.example) the official Maps Embed API; without it
 * Google's keyless `/maps?q=...&output=embed` URL (unofficial, no place ID
 * support). The token-drawn MapPlaceholder shows while the iframe loads.
 *
 * Customise: `variant` (card | outline | bare), `aspect` (video | wide |
 * classic | square | portrait | tall | fill, or a `[--embed-aspect:5/2]` class),
 * `frameClass`, `actionsClass`, `showDirections`, `showOpenInMaps`. Parts:
 * `data-slot="map"`, `map-actions`, `map-directions`,
 * `map-open`, plus the `embed-*` slots of Embed.
 *
 * Privacy: the iframe sends only the site origin as referrer
 * (`strict-origin-when-cross-origin`, required for key referrer
 * restrictions).
 */
import { PUBLIC_GOOGLE_MAPS_EMBED_KEY } from "astro:env/client"
import type { HTMLAttributes } from "astro/types"
import { Icon } from "astro-icon/components"

import Embed from "@/components/blocks/embed/Embed.astro"
import type { EmbedVariants } from "@/components/blocks/embed/variants"
import { buttonVariants } from "@/components/ui/button"
import {
  addressText,
  directionsUrl,
  searchUrl,
  type Address,
  type MapLocation,
} from "@/lib/contact-links"
import { cn } from "@/lib/utils"
import { siteConfig } from "@/site.config"

import { embedUrl, type EmbedOptions } from "./google-maps"
import MapPlaceholder from "./MapPlaceholder.astro"
import { mapActionsVariants } from "./variants"

export type Props = Omit<HTMLAttributes<"div">, "title"> &
  EmbedVariants &
  MapLocation &
  EmbedOptions & {
    /** Place name for the default query and iframe title. */
    name?: string
    /** Address for the default query and iframe title (object or one line), or `false`. */
    address?: Address | string | false
    /** iframe title (accessible name). Default "Map of <name>, <address>". */
    title?: string
    /** Google Business Profile URL for "Open in Google Maps". */
    googleMapsUrl?: string
    showDirections?: boolean
    showOpenInMaps?: boolean
    frameClass?: string
    actionsClass?: string
  }

const {
  name = siteConfig.name,
  address = siteConfig.contact.address ?? false,
  placeId,
  query: queryProp,
  lat: latProp,
  lng: lngProp,
  zoom = 15,
  language = siteConfig.locale,
  region,
  maptype,
  title: titleProp,
  googleMapsUrl = siteConfig.business.googleMapsUrl,
  showDirections = true,
  showOpenInMaps = true,
  variant,
  aspect = "classic",
  class: className,
  frameClass,
  actionsClass,
  ...rest
} = Astro.props

const addressLine =
  typeof address === "string" ? address : address ? addressText(address) : ""
const explicitCoords = latProp !== undefined && lngProp !== undefined
// business.geo only describes the site's own address: skip it when the
// location is overridden.
const siteGeo =
  Astro.props.address === undefined && !queryProp && !placeId
    ? siteConfig.business.geo
    : undefined

const location: MapLocation = {
  placeId,
  query:
    queryProp ??
    (explicitCoords || !addressLine ? undefined : `${name}, ${addressLine}`),
  lat: latProp ?? siteGeo?.latitude,
  lng: lngProp ?? siteGeo?.longitude,
}

if (!location.query && !location.placeId && location.lat === undefined) {
  throw new Error(
    "Map: pass query, placeId or lat/lng, or set contact.address / business.geo in site.config.ts"
  )
}

const options = { zoom, language, region, maptype }
const src = embedUrl(location, {
  ...options,
  key: PUBLIC_GOOGLE_MAPS_EMBED_KEY,
})
const openUrl = googleMapsUrl ?? searchUrl(location)
const title =
  titleProp ?? `Map of ${[name, addressLine].filter(Boolean).join(", ")}`
---

<div data-slot="map" class={cn("flex flex-col gap-3", className)} {...rest}>
  <Embed
    src={src}
    title={title}
    allowFullscreen
    variant={variant}
    aspect={aspect}
    class={frameClass}
  >
    <MapPlaceholder />
  </Embed>

  {(showDirections || showOpenInMaps) && (
    <div
      data-slot="map-actions"
      class={cn(mapActionsVariants({ variant }), actionsClass)}
    >
      {showDirections && (
        <a
          href={directionsUrl(location)}
          target="_blank"
          rel="noopener noreferrer"
          data-slot="map-directions"
          class={buttonVariants({ variant: "secondary" })}
        >
          <Icon name="lucide:navigation" aria-hidden="true" />
          Get directions<span class="sr-only"> (opens Google Maps)</span>
        </a>
      )}
      {showOpenInMaps && (
        <a
          href={openUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-slot="map-open"
          class={buttonVariants({ variant: "ghost" })}
        >
          <Icon name="lucide:external-link" aria-hidden="true" />
          Open in Google Maps<span class="sr-only"> (opens in a new tab)</span>
        </a>
      )}
    </div>
  )}
</div>
