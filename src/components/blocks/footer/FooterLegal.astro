---
/**
 * Legal line: copyright ("© 2026 Acme Plumbing Ltd", owner defaults to the
 * organisation's legal name) and optional legal links (privacy, cookies,
 * terms). Extra text such as a company or Gas Safe registration number goes
 * in the default slot.
 */
import type { HTMLAttributes } from "astro/types"

import { isExternal } from "@/lib/nav"
import { cn } from "@/lib/utils"
import { siteConfig, type NavLink } from "@/site.config"

import { footerLinkVariants } from "./variants"

type Props = HTMLAttributes<"div"> & {
  owner?: string
  year?: number
  links?: NavLink[]
  /** Accessible name of the links nav. */
  label?: string
}

const {
  owner = siteConfig.organisation.legalName ?? siteConfig.organisation.name,
  year = new Date().getFullYear(),
  links = [],
  label = "Legal",
  class: className,
  ...rest
} = Astro.props
---

<div
  data-slot="footer-legal"
  class={cn(
    "flex flex-col gap-x-6 gap-y-2 text-sm text-muted-foreground md:flex-row md:flex-wrap md:items-center",
    className
  )}
  {...rest}
>
  <p data-slot="footer-copyright">
    &copy; {year} {owner}
  </p>
  <slot />
  {links.length > 0 && (
    <nav aria-label={label}>
      <ul class="flex flex-wrap gap-x-4 gap-y-2">
        {links.map((link) => {
          const external = isExternal(link)
          return (
            <li>
              <a
                href={link.href}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
                data-slot="footer-link"
                class={footerLinkVariants()}
              >
                {link.label}
              </a>
            </li>
          )
        })}
      </ul>
    </nav>
  )}
</div>
