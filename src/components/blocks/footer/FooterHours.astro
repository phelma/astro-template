---
/**
 * Opening-hours column: a heading plus whatever you put in the default slot
 * (e.g. an opening-hours block). Without slot content it renders the compact
 * OpeningHoursList ("Mon–Fri 9am–5:30pm", today highlighted after load) of
 * siteConfig.business.hours (or `hours`), and nothing if there are none.
 *
 *   <FooterHours title="Opening hours"><OpeningHoursSummary /></FooterHours>
 */
import type { HTMLAttributes } from "astro/types"

import OpeningHoursList from "@/components/blocks/opening-hours/OpeningHoursList.astro"
import type { HeadingLevel } from "@/components/blocks/section/variants"
import { cn } from "@/lib/utils"
import { siteConfig, type BusinessHours } from "@/site.config"

type Props = HTMLAttributes<"div"> & {
  title?: string
  headingLevel?: HeadingLevel
  /** Fallback list data; ignored when the slot has content. */
  hours?: BusinessHours
}

const {
  title = siteConfig.footerOptions.hoursTitle,
  headingLevel = 2,
  hours = siteConfig.business.hours,
  class: className,
  ...rest
} = Astro.props

const Heading = `h${headingLevel}` as const
const custom = Astro.slots.has("default")
---

{(custom || hours.length > 0) && (
  <div
    data-slot="footer-hours"
    class={cn("flex flex-col gap-4 text-sm", className)}
    {...rest}
  >
    {title && (
      <Heading
        data-slot="footer-heading"
        class="text-sm font-semibold text-(--footer-foreground)"
      >
        {title}
      </Heading>
    )}
    {custom ? (
      <slot />
    ) : (
      <OpeningHoursList
        hours={hours}
        density="compact"
        class="text-muted-foreground **:data-[slot=opening-hours-row]:border-b-0 **:data-[slot=opening-hours-row]:px-0 **:data-[slot=opening-hours-row]:py-1 **:data-today:bg-transparent **:data-today:text-(--footer-foreground)"
      />
    )}
  </div>
)}
