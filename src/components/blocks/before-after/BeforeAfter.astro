---
/**
 * Before/after comparison slider for two photos of the same size.
 *
 *   <BeforeAfter
 *     before={{ src: bathroomBefore, alt: "Dated bathroom with a cracked bath" }}
 *     after={{ src: bathroomAfter, alt: "Refitted bathroom with a walk-in shower" }}
 *     caption="Bathroom refit, Hove"
 *   />
 *
 * A visually hidden native `<input type="range">` drives the divider, so it
 * works with the keyboard (arrows, Page Up/Down, Home/End) and screen
 * readers (named by `label`, value read as "60% before, 40% after").
 * Dragging anywhere on the photo moves it too. Without JS the two photos
 * show side by side (stacked on small screens / `vertical`), each tagged.
 */
import type { HTMLAttributes } from "astro/types"
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"

import { cn } from "@/lib/utils"

import type { ComparisonImage } from "./before-after"
import {
  beforeAfterLabelVariants,
  beforeAfterVariants,
  type BeforeAfterLabelVariants,
  type BeforeAfterVariants,
} from "./variants"

type Props = HTMLAttributes<"figure"> &
  BeforeAfterVariants & {
    before: ComparisonImage
    after: ComparisonImage
    caption?: string
    /** Accessible name of the slider. */
    label?: string
    beforeLabel?: string
    afterLabel?: string
    labelTone?: BeforeAfterLabelVariants["tone"]
    /** Initial divider position, 0-100 (% of "before" shown). */
    position?: number
    /** `sizes` for both images' srcset. */
    sizes?: string
    /** Load eagerly with high priority (one above-the-fold image per page). */
    priority?: boolean
    frameClass?: string
  }

const {
  before,
  after,
  caption,
  label = caption
    ? `Before/after comparison: ${caption}`
    : "Before/after comparison",
  beforeLabel = "Before",
  afterLabel = "After",
  labelTone,
  position = 50,
  sizes = "(min-width: 1152px) 1152px, 100vw",
  priority = false,
  orientation = "horizontal",
  frameClass,
  class: className,
  ...rest
} = Astro.props

const widths = [480, 640, 800, 1024, 1280, 1600].filter(
  (w) => w <= before.src.width
)
const layers = [
  { key: "before", image: before, tag: beforeLabel },
  { key: "after", image: after, tag: afterLabel },
] as const
---

<figure
  data-slot="before-after"
  data-before-after
  data-orientation={orientation}
  class={cn(beforeAfterVariants({ orientation }), className)}
  {...rest}
>
  <div
    data-slot="before-after-frame"
    class={cn("relative rounded-lg select-none", frameClass)}
  >
    {layers.map(({ key, image, tag }) => (
      <div
        data-slot="before-after-layer"
        data-layer={key}
        class="relative overflow-hidden rounded-[inherit] bg-muted"
      >
        <Image
          src={image.src}
          alt={image.alt}
          layout="none"
          widths={widths.length > 0 ? widths : [image.src.width]}
          sizes={sizes}
          priority={priority}
          draggable="false"
          data-slot="before-after-image"
          class="block h-auto w-full"
        />
        <span
          data-slot="before-after-label"
          data-label={key}
          class={beforeAfterLabelVariants({ tone: labelTone })}
        >
          {tag}
        </span>
      </div>
    ))}
    <div
      data-slot="before-after-handle"
      aria-hidden="true"
      hidden
      class="pointer-events-none absolute z-20"
    >
      <span
        data-slot="before-after-divider"
        class="absolute bg-background shadow-sm"
      ></span>
      <span
        data-slot="before-after-knob"
        class="absolute top-1/2 left-1/2 inline-flex size-11 -translate-1/2 items-center justify-center rounded-md border bg-background text-foreground shadow-md group-has-focus-visible/before-after:outline-2 group-has-focus-visible/before-after:outline-offset-2 group-has-focus-visible/before-after:outline-ring"
      >
        <Icon
          name={
            orientation === "vertical"
              ? "lucide:chevrons-up-down"
              : "lucide:chevrons-left-right"
          }
          class="size-5"
        />
      </span>
    </div>
    <input
      type="range"
      min="0"
      max="100"
      step="1"
      value={position}
      aria-label={label}
      aria-orientation={orientation === "vertical" ? "vertical" : undefined}
      data-slot="before-after-range"
      data-before-label={beforeLabel}
      data-after-label={afterLabel}
      hidden
      class="sr-only"
    />
  </div>
  {caption && (
    <figcaption
      data-slot="before-after-caption"
      class="mt-3 text-sm text-muted-foreground"
    >
      {caption}
    </figcaption>
  )}
</figure>

<style>
  /* Mechanics only; visuals are utilities in the markup. `--position` is the
     share of the "before" photo shown, set by the script from the range. */
  [data-slot="before-after"] {
    --position: 50%;
  }

  /* Without JS: both photos, side by side from 40rem (horizontal only). */
  [data-slot="before-after-frame"] {
    display: grid;
    gap: 0.5rem;
  }

  @media (min-width: 40rem) {
    [data-orientation="horizontal"]:not([data-enhanced])
      [data-slot="before-after-frame"] {
      grid-template-columns: 1fr 1fr;
    }
  }

  [data-slot="before-after-label"] {
    top: 0.75rem;
    left: 0.75rem;
  }

  /* Enhanced: stack the photos and clip "before" at the divider. */
  [data-enhanced] [data-slot="before-after-frame"] {
    gap: 0;
    overflow: hidden;
    cursor: ew-resize;
    touch-action: pan-y pinch-zoom;
  }

  [data-enhanced] [data-slot="before-after-layer"] {
    grid-area: 1 / 1;
    border-radius: 0;
  }

  [data-enhanced] [data-layer="before"] {
    z-index: 1;
    clip-path: inset(0 calc(100% - var(--position)) 0 0);
  }

  [data-enhanced] [data-label="after"] {
    right: 0.75rem;
    left: auto;
  }

  [data-slot="before-after-handle"] {
    inset-block: 0;
    left: var(--position);
    width: 0;
  }

  [data-slot="before-after-divider"] {
    inset-block: 0;
    left: -1px;
    width: 2px;
  }

  /* Vertical: before on top, divider moves up and down. */
  [data-enhanced][data-orientation="vertical"]
    [data-slot="before-after-frame"] {
    cursor: ns-resize;
    touch-action: pan-x pinch-zoom;
  }

  [data-enhanced][data-orientation="vertical"] [data-layer="before"] {
    clip-path: inset(0 0 calc(100% - var(--position)) 0);
  }

  [data-enhanced][data-orientation="vertical"] [data-label="after"] {
    top: auto;
    right: auto;
    bottom: 0.75rem;
    left: 0.75rem;
  }

  [data-orientation="vertical"] [data-slot="before-after-handle"] {
    inset-block: auto;
    inset-inline: 0;
    top: var(--position);
    left: 0;
    width: auto;
    height: 0;
  }

  [data-orientation="vertical"] [data-slot="before-after-divider"] {
    inset-inline: 0;
    inset-block: auto;
    top: -1px;
    left: 0;
    width: auto;
    height: 2px;
  }
</style>

<script>
  // Progressive enhancement: overlay the photos and let the range input
  // (keyboard, screen readers) and pointer drags move the divider.
  function enhance(root: HTMLElement) {
    const frame = root.querySelector<HTMLElement>(
      "[data-slot=before-after-frame]"
    )
    const range = root.querySelector<HTMLInputElement>(
      "[data-slot=before-after-range]"
    )
    const handle = root.querySelector<HTMLElement>(
      "[data-slot=before-after-handle]"
    )
    if (!frame || !range || !handle || root.dataset.enhanced !== undefined)
      return

    const vertical = root.dataset.orientation === "vertical"
    const beforeLabel = range.dataset.beforeLabel ?? "Before"
    const afterLabel = range.dataset.afterLabel ?? "After"

    const set = (value: number) => {
      const v = Math.round(Math.min(100, Math.max(0, value)))
      range.value = String(v)
      root.style.setProperty("--position", `${v}%`)
      range.setAttribute(
        "aria-valuetext",
        `${v}% ${beforeLabel.toLowerCase()}, ${100 - v}% ${afterLabel.toLowerCase()}`
      )
    }

    range.addEventListener("input", () => set(Number(range.value)))

    // Native ranges step "up" with ArrowUp; vertically the divider should
    // follow the arrow, so invert Up/Down.
    if (vertical) {
      range.addEventListener("keydown", (event) => {
        const delta =
          event.key === "ArrowDown" ? 1 : event.key === "ArrowUp" ? -1 : 0
        if (!delta) return
        event.preventDefault()
        set(Number(range.value) + delta)
      })
    }

    const fromPointer = (event: PointerEvent) => {
      const rect = frame.getBoundingClientRect()
      set(
        vertical
          ? ((event.clientY - rect.top) / rect.height) * 100
          : ((event.clientX - rect.left) / rect.width) * 100
      )
    }

    // Mouse/pen: press anywhere to jump, then drag. Touch: move only once
    // the browser knows it's a drag along the slider (a pan the other way
    // scrolls the page and cancels the pointer), or on a tap.
    frame.addEventListener("pointerdown", (event) => {
      if (!event.isPrimary || event.button !== 0) return
      frame.setPointerCapture(event.pointerId)
      range.focus({ preventScroll: true })
      if (event.pointerType !== "touch") fromPointer(event)
      event.preventDefault()
    })
    frame.addEventListener("pointermove", (event) => {
      if (frame.hasPointerCapture(event.pointerId)) fromPointer(event)
    })
    frame.addEventListener("pointerup", (event) => {
      if (event.pointerType === "touch") fromPointer(event)
    })

    range.hidden = false
    handle.hidden = false
    root.dataset.enhanced = ""
    set(Number(range.value))
  }

  document
    .querySelectorAll<HTMLElement>("[data-before-after]")
    .forEach((root) => enhance(root))
</script>
