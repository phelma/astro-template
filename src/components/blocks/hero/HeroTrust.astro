---
/**
 * Trust line under the hero actions: ratings, accreditations, years trading.
 *
 *   <HeroTrust items={[
 *     { label: "4.9 on Google", icon: "lucide:star" },
 *     "Gas Safe registered",
 *     "25 years in Leeds",
 *   ]} />
 *
 * Strings get a tick icon. Items with `href` link out (e.g. to reviews).
 */
import type { HTMLAttributes } from "astro/types"
import { Icon } from "astro-icon/components"

import { cn } from "@/lib/utils"

export type HeroTrustItem =
  | string
  | {
      label: string
      /** astro-icon name. Decorative. Default "lucide:circle-check". */
      icon?: string
      href?: string
    }

type Props = HTMLAttributes<"ul"> & {
  items: HeroTrustItem[]
}

const { items, class: className, ...rest } = Astro.props

const normalised = items.map((item) =>
  typeof item === "string" ? { label: item } : item
)
---

<ul
  data-slot="hero-trust"
  class={cn(
    "flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted-foreground group-data-[align=center]/hero:justify-center group-data-[layout=overlay]/hero:text-current",
    className
  )}
  {...rest}
>
  {normalised.map(({ label, icon = "lucide:circle-check", href }) => (
    <li data-slot="hero-trust-item" class="inline-flex items-center gap-1.5">
      <Icon
        name={icon}
        aria-hidden="true"
        class="size-4 shrink-0 text-primary group-data-[layout=overlay]/hero:text-current"
      />
      {href ? (
        <a
          href={href}
          class="inline-flex min-h-6 items-center underline underline-offset-4 hover:decoration-2"
        >
          {label}
        </a>
      ) : (
        <span>{label}</span>
      )}
    </li>
  ))}
</ul>
