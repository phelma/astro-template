---
/**
 * Supporting paragraph under the hero title. Muted, except on overlays where
 * it takes the scrim's full-contrast text colour.
 */
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"p">

const { class: className, ...rest } = Astro.props
---

<p
  data-slot="hero-lede"
  class={cn(
    "max-w-prose text-lg text-muted-foreground group-data-[layout=overlay]/hero:text-current",
    "md:group-data-[size=lg]/hero:text-xl md:group-data-[size=screen]/hero:text-xl",
    className
  )}
  {...rest}
>
  <slot />
</p>
