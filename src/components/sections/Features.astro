---
/**
 * Deprecated: use `@/components/blocks/features/Features.astro`. Kept as a
 * thin wrapper (cards variant) so existing pages keep working.
 */
import FeaturesBlock from "@/components/blocks/features/Features.astro"
import type { FeatureItem } from "@/components/blocks/features/variants"

export type Feature = FeatureItem

interface Props {
  id?: string
  title: string
  intro?: string
  features: Feature[]
}

const { id, title, intro, features } = Astro.props
---

<FeaturesBlock
  id={id}
  title={title}
  lede={intro}
  items={features}
  variant="cards"
/>
