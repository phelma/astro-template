---
/**
 * Features grid: a section heading plus shadcn Cards with astro-icon icons.
 * Cards are React components rendered at build time (no client JS).
 */
import { Icon } from "astro-icon/components"

import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"

export interface Feature {
  /** astro-icon name, e.g. "lucide:zap". Decorative. */
  icon: string
  title: string
  description: string
}

interface Props {
  id?: string
  title: string
  intro?: string
  features: Feature[]
}

const { id = "features", title, intro, features } = Astro.props
---

<section
  aria-labelledby={`${id}-title`}
  class="mx-auto max-w-6xl px-4 py-16 sm:px-6"
>
  <div class="mb-10 flex max-w-2xl flex-col gap-3">
    <h2 id={`${id}-title`} class="text-3xl">
      {title}
    </h2>
    {intro && <p class="text-muted-foreground">{intro}</p>}
  </div>
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((feature) => (
      <li class="flex">
        <Card className="w-full">
          <CardHeader>
            <span class="mb-2 inline-flex size-10 items-center justify-center rounded-lg bg-muted text-foreground">
              <Icon name={feature.icon} class="size-5" aria-hidden="true" />
            </span>
            <CardTitle>
              <h3 class="text-lg">{feature.title}</h3>
            </CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription>{feature.description}</CardDescription>
          </CardContent>
        </Card>
      </li>
    ))}
  </ul>
</section>
