---
/**
 * Page hero: the page's single <h1>, a lede, call-to-action slot and an
 * optional image. The image is the LCP element, so it is loaded with
 * `priority` (eager, sync decode, fetchpriority="high"). Use `priority` on
 * at most one image per page, and only above the fold.
 */
import type { ImageMetadata } from "astro"
import { Picture } from "astro:assets"

interface Props {
  title: string
  lede?: string
  image?: ImageMetadata
  /** Required when `image` is set. Describe the image; use "" only if purely decorative. */
  imageAlt?: string
}

const { title, lede, image, imageAlt = "" } = Astro.props
---

<section
  aria-labelledby="hero-title"
  class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 md:py-24 lg:grid-cols-2"
>
  <div class="flex flex-col items-start gap-6">
    <h1 id="hero-title" class="text-4xl sm:text-5xl">
      {title}
    </h1>
    {lede && <p class="max-w-prose text-lg text-muted-foreground">{lede}</p>}
    {Astro.slots.has("default") && (
      <div class="flex flex-wrap gap-3">
        <slot />
      </div>
    )}
  </div>

  {image && (
    <Picture
      src={image}
      alt={imageAlt}
      formats={["avif", "webp"]}
      width={800}
      height={Math.round((800 * image.height) / image.width)}
      priority
      class="h-auto w-full rounded-xl border shadow-md"
    />
  )}
</section>
