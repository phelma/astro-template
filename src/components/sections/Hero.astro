---
/**
 * Deprecated: use `@/components/blocks/hero/Hero.astro`. Kept as a thin
 * wrapper (split layout; call-to-action links in the default slot) so
 * existing pages keep working.
 */
import type { ImageMetadata } from "astro"

import HeroBlock from "@/components/blocks/hero/Hero.astro"

interface Props {
  title: string
  lede?: string
  image?: ImageMetadata
  /** Required when `image` is set. Describe the image; use "" only if purely decorative. */
  imageAlt?: string
}

const { title, lede, image, imageAlt } = Astro.props
---

{Astro.slots.has("default") ? (
  <HeroBlock title={title} lede={lede} image={image} imageAlt={imageAlt}>
    <slot />
  </HeroBlock>
) : (
  <HeroBlock title={title} lede={lede} image={image} imageAlt={imageAlt} />
)}
