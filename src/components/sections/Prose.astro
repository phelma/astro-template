---
/**
 * Minimal long-form text styles for slotted Markdown-like content (headings,
 * paragraphs, lists, links, code). Uses theme tokens only.
 */
import { cn } from "@/lib/utils"

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<div class={cn("prose mx-auto max-w-6xl px-4 pb-16 sm:px-6", className)}>
  <div class="max-w-prose">
    <slot />
  </div>
</div>

<style>
  .prose :global(:where(h2)) {
    margin-block: 2.5rem 1rem;
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
  }
  .prose :global(:where(h3)) {
    margin-block: 2rem 0.75rem;
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
  }
  .prose :global(:where(p, ul, ol, address, blockquote)) {
    margin-block: 1rem;
    line-height: 1.75;
  }
  .prose :global(:where(ul)) {
    list-style: disc;
    padding-inline-start: 1.5rem;
  }
  .prose :global(:where(ol)) {
    list-style: decimal;
    padding-inline-start: 1.5rem;
  }
  .prose :global(:where(li + li)) {
    margin-block-start: 0.25rem;
  }
  .prose :global(:where(a)) {
    color: var(--foreground);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .prose :global(:where(a:hover)) {
    text-decoration-thickness: 2px;
  }
  .prose :global(:where(strong)) {
    font-weight: 600;
  }
  .prose :global(:where(address)) {
    font-style: normal;
  }
  .prose :global(:where(code)) {
    border-radius: var(--radius-sm);
    background-color: var(--muted);
    padding: 0.125rem 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.875em;
  }
  .prose :global(:where(blockquote)) {
    border-inline-start: 4px solid var(--border);
    padding-inline-start: 1rem;
    color: var(--muted-foreground);
  }
  .prose > div > :global(:first-child) {
    margin-block-start: 0;
  }
</style>
