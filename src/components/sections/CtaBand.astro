---
/**
 * Full-width call-to-action band. Put links/buttons in the default slot.
 */
interface Props {
  id?: string
  title: string
  text?: string
}

const { id = "cta", title, text } = Astro.props
---

<section aria-labelledby={`${id}-title`} class="border-y bg-muted">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-16 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div class="flex max-w-2xl flex-col gap-3">
      <h2 id={`${id}-title`} class="text-3xl">
        {title}
      </h2>
      {text && <p class="text-muted-foreground">{text}</p>}
    </div>
    <div class="flex flex-wrap gap-3">
      <slot />
    </div>
  </div>
</section>
